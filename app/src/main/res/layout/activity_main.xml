<?xml version="1.0" encoding="utf-8"?>
<!--
  主页面（v1.4 起拆页）：只放**每天要动的东西** —— 运行状态、无障碍入口、以及
  「行为与触发 / SoM 标注 / 答完自动下一题 / 答题自动提交」这几个开关。
  接口地址、Key、识别参数、解析服务、日志等低频项全部移到 activity_settings.xml。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ============ 运行状态 ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:text="@string/sec_status"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="" />

        <Button
            android:id="@+id/btnOpenA11y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_open_a11y" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:background="?android:attr/listDivider" />

        <!-- ============ 行为与触发 ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:text="@string/sec_behavior"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/swProcessing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sw_processing" />

        <Switch
            android:id="@+id/swAutoClick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sw_auto_click" />

        <Switch
            android:id="@+id/swDryRun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sw_dry_run" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:background="?android:attr/listDivider" />

        <!-- ============ SoM 编号标注 ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:text="@string/sec_som"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/swSom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sw_som" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:background="?android:attr/listDivider" />

        <!-- ============ 答完自动下一题 ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:text="@string/sec_auto_advance"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/swAutoAdvance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sw_auto_advance" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/lbl_auto_advance_max_streak" />

        <EditText
            android:id="@+id/etAutoAdvanceMaxStreak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:background="?android:attr/listDivider" />

        <!-- ============ 答题自动提交（整卷收尾） ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:text="@string/sec_finish"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="@string/lbl_finish_mode" />

        <RadioGroup
            android:id="@+id/rgFinishMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbFinishOff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rb_finish_off" />

            <RadioButton
                android:id="@+id/rbFinishSubmit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rb_finish_submit" />

            <RadioButton
                android:id="@+id/rbFinishIdle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rb_finish_idle" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:background="?android:attr/listDivider" />

        <!-- ============ 高级设置入口 ============ -->
        <Button
            android:id="@+id/btnOpenSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/sec_log_hint" />
    </LinearLayout>
</ScrollView>
