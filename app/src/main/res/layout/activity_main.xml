<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ============ 运行状态 ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:text="@string/sec_status"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="" />

        <Button
            android:id="@+id/btnOpenA11y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_open_a11y" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:background="?android:attr/listDivider" />

        <!-- ============ 大模型配置 ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:text="@string/sec_config"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etBaseUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_base_url"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1" />

        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_api_key"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:maxLines="1" />

        <EditText
            android:id="@+id/etModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_model"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1" />

        <Button
            android:id="@+id/btnListModels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_list_models"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/lbl_reasoning_effort" />

        <EditText
            android:id="@+id/etReasoningEffort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_reasoning_effort"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1" />

        <EditText
            android:id="@+id/etSystemPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="@string/hint_system_prompt"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:minLines="4" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_save" />

        <Button
            android:id="@+id/btnDefaultPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_default_prompt" />

        <Button
            android:id="@+id/btnImportConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_import_config" />

        <Button
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_test" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:background="?android:attr/listDivider" />

        <!-- ============ 行为与触发 ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:text="@string/sec_behavior"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/swProcessing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sw_processing" />

        <Switch
            android:id="@+id/swAutoClick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sw_auto_click" />

        <Switch
            android:id="@+id/swDryRun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sw_dry_run" />

        <Switch
            android:id="@+id/swSendScreenshot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sw_send_screenshot" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/lbl_image_max_side" />

        <EditText
            android:id="@+id/etImageMaxSide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/lbl_poll_interval" />

        <EditText
            android:id="@+id/etPollInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/lbl_ocr_scale" />

        <EditText
            android:id="@+id/etOcrScale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/lbl_min_score" />

        <EditText
            android:id="@+id/etMinScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/lbl_debounce" />

        <EditText
            android:id="@+id/etDebounce"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/lbl_min_conf" />

        <EditText
            android:id="@+id/etMinConf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/lbl_dedup" />

        <EditText
            android:id="@+id/etDedup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/lbl_timeout" />

        <EditText
            android:id="@+id/etTimeout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="number" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:background="?android:attr/listDivider" />

        <!-- ============ 日志 ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:text="@string/sec_log"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRefreshLog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_refresh_log" />

            <Button
                android:id="@+id/btnClearLog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_clear_log" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="6dp"
            android:background="?android:attr/colorBackground"
            android:padding="6dp">

            <TextView
                android:id="@+id/logText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text=""
                android:textSize="11sp" />
        </ScrollView>

    </LinearLayout>
</ScrollView>
